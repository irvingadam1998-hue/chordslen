# Frontend (copy the three variables to frontend/.env.local for local development)
FLASK_API_URL=http://localhost:5002
FLASK_API_KEY=change-me
PUBLIC_WORKER_URL=http://localhost:5002

# Worker
PORT=5002
API_KEY=change-me
MAX_CONCURRENT_JOBS=1
JOB_TTL_SECONDS=3600
MAX_UPLOAD_MB=50
EXTRACTOR_FILE_TTL_SECONDS=900
YOUTUBE_MIN_INTERVAL_SECONDS=5
YOUTUBE_COOLDOWN_SECONDS=900
# Optional: cookies belong only on the worker, never in the frontend or git.
YOUTUBE_COOKIES_B64=
YOUTUBE_COOKIES_FILE=
# Leave client selection to yt-dlp by default.
YTDLP_PLAYER_CLIENTS=
YTDLP_PO_TOKEN=
YTDLP_PO_TOKEN_CLIENT=mweb.gvs
